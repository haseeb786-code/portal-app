# ==========================================
# ODOCUST ACADEMIC MONITOR CONFIGURATION
# ==========================================

# 1. ODOCUST University Portal Credentials
ODOCUST_BASE_URL=https://odoo.cust.edu.pk
ODOCUST_USERNAME=BSEXXXXXX
ODOCUST_PASSWORD=YourPasswordHere

# Optional: If you prefer using your active browser session cookie instead of password:
ODOCUST_SESSION_ID=

# 2. Monitoring & Reminders
CHECK_INTERVAL_MINUTES=15
# Hours before deadline to send automated WhatsApp reminders:
REMINDER_HOURS=72,48,24,12,6,3,1

# 3. WhatsApp Notification Provider
# Options: 'console_log' (testing), 'twilio', 'callmebot', 'greenapi', 'meta'
WHATSAPP_PROVIDER=console_log
WHATSAPP_TO_NUMBER=+923001234567

# --- Twilio WhatsApp Settings (If using Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- CallMeBot Settings (Instant free WhatsApp for personal numbers) ---
# To get your free API key, send "I allow callmebot to send me messages" to +34 941 83 04 22 on WhatsApp
CALLMEBOT_PHONE=+923001234567
CALLMEBOT_API_KEY=

# --- Green-API Settings (If using Green-API) ---
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=

# --- Telegram Option (100% Free, zero slot limits, instant) ---
# Option A: CallMeBot Telegram (Just send /start to @CallMeBot_txtbot on Telegram)
TELEGRAM_USERNAME=@YourTelegramUsername
# Option B: Direct Telegram Bot (Create free bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Daily Academic Summary
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME=08:00

# 5. Local Dashboard Server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DATABASE_PATH=odocust_monitor.db

# 6. AI Academic Copilot & GPA Engine
AI_AGENT_ENABLED=true
# Optional: Add Google Gemini API key for deep AI analysis (Free at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
STUDENT_CURRENT_CGPA=3.20
STUDENT_TARGET_GPA=3.50
STUDENT_COMPLETED_CREDITS=100

